# =========================
# Test Environment
# =========================

FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Run production build as a test
RUN npm run build

# Run the application
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
